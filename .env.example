# Copy this file to .env.local and adjust values for your machine.
# .env.local is git-ignored. Never commit real secrets.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle
# and are therefore PUBLIC. Never put a secret behind that prefix.

# Display name of the application.
NEXT_PUBLIC_APP_NAME="Progress Tracker"

# Absolute origin the app is served from.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL of the REST API.
# Reserved for Phase 5. Leave commented out until the backend exists.
# NEXT_PUBLIC_API_URL="http://localhost:8000/api"
